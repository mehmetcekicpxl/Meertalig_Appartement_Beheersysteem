<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5"
    tools:context=".fragments.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Blue Header Background -->
        <View
            android:id="@+id/viewHeaderBg"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@drawable/bg_header_rounded"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Header Content -->
        <ImageView
            android:id="@+id/ivHeaderIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_home"
            android:background="@drawable/bg_header_rounded"
            android:backgroundTint="#20FFFFFF"
            android:padding="8dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvWelcomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/ivHeaderIcon"
            app:layout_constraintTop_toTopOf="@id/ivHeaderIcon"
            app:layout_constraintBottom_toTopOf="@+id/tvHeaderTitle" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apartment_management"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/ivHeaderIcon"
            app:layout_constraintBottom_toBottomOf="@id/ivHeaderIcon"
            app:layout_constraintTop_toBottomOf="@id/tvWelcomeLabel" />

        <!-- Date Selector -->
        <LinearLayout
            android:id="@+id/layoutDateSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_header_rounded"
            android:backgroundTint="#20FFFFFF"
            android:padding="12dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/ivHeaderIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <!-- (Content remains same) -->
            <ImageButton
                android:id="@+id/btnPrevMonth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_calendar"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:rotation="90"
                android:contentDescription="Önceki Ay" />

            <TextView
                android:id="@+id/tvDateHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/placeholder_date"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_calendar"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:rotation="-90"
                android:contentDescription="Sonraki Ay" />
        </LinearLayout>

        <!-- Currency Config Button (Top Right) -->
        <TextView
            android:id="@+id/btnCurrencyConfig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="24dp"
            android:text="DÖVİZ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_header_rounded"
            android:backgroundTint="#20FFFFFF"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Filter Toggle Group (Relocated Here) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/btnFilterAll"
            app:layout_constraintTop_toBottomOf="@id/layoutDateSelector"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_all"
                android:textColor="@color/selector_toggle_text_reports"
                app:backgroundTint="@color/selector_toggle_bg_reports"
                app:strokeColor="@android:color/white"
                android:paddingHorizontal="24dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterRent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_rent"
                android:textColor="@color/selector_toggle_text_reports"
                app:backgroundTint="@color/selector_toggle_bg_reports"
                app:strokeColor="@android:color/white"
                android:paddingHorizontal="24dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterAidat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_aidat"
                android:textColor="@color/selector_toggle_text_reports"
                app:backgroundTint="@color/selector_toggle_bg_reports"
                app:strokeColor="@android:color/white"
                android:paddingHorizontal="24dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Balance Card (Updated Constraints) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/toggleGroupFilter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <!-- (Content remains same) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="center_vertical">

                <!-- Rent Total -->
                <LinearLayout
                    android:id="@+id/layoutTotalRent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_rent_collected"
                        android:textSize="14sp"
                        android:alpha="0.8"
                        android:textColor="#212121"/>

                    <TextView
                        android:id="@+id/tvTotalRent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₺0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5"/>

                    <TextView
                        android:id="@+id/tvRentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0 Ödedi"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <View
                    android:id="@+id/dividerTotal"
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="#DDDDDD"
                    android:layout_marginHorizontal="16dp"/>

                <!-- Aidat Total -->
                <LinearLayout
                    android:id="@+id/layoutTotalAidat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_aidat_collected"
                        android:textSize="14sp"
                        android:alpha="0.8"
                        android:textColor="#212121"/>

                    <TextView
                        android:id="@+id/tvTotalAidat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₺0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5"/>

                    <TextView
                        android:id="@+id/tvAidatCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0 Ödedi"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- List Header -->
        <TextView
            android:id="@+id/tvListHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apartment_list"
            android:textColor="#3F51B5"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardBalance"
            app:layout_constraintStart_toStartOf="parent" />
            
        <TextView
            android:id="@+id/tvListPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_period"
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvListHeader"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPaymentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingBottom="80dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tvListHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
