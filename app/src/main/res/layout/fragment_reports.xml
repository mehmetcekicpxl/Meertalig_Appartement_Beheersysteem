<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Blue Header Background -->
        <View
            android:id="@+id/viewHeaderBg"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_header_rounded"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTitleReports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reports_and_analysis"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="32dp"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitleReports">

            <!-- Filter Toggle Group -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupFilterReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btnFilterAllRep">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterAllRep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_all"
                    android:textColor="@color/selector_toggle_text_reports"
                    app:backgroundTint="@color/selector_toggle_bg_reports"
                    app:strokeColor="@android:color/white"
                    android:paddingHorizontal="24dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterRentRep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_rent"
                    android:textColor="@color/selector_toggle_text_reports"
                    app:backgroundTint="@color/selector_toggle_bg_reports"
                    app:strokeColor="@android:color/white"
                    android:paddingHorizontal="24dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterAidatRep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_aidat"
                    android:textColor="@color/selector_toggle_text_reports"
                    app:backgroundTint="@color/selector_toggle_bg_reports"
                    app:strokeColor="@android:color/white"
                    android:paddingHorizontal="24dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Year Filter Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <Spinner
                        android:id="@+id/spinnerYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvYearlyTitle"
                android:text="@string/placeholder_financial_summary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Yearly Summary Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">
                    <TextView
                        android:id="@+id/tvYearlyIncome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/placeholder_income"
                        android:textColor="#4CAF50"
                        android:textAlignment="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">
                    <TextView
                        android:id="@+id/tvYearlyExpense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/placeholder_expense"
                        android:textColor="#F44336"
                        android:textAlignment="center"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">
                    <TextView
                        android:id="@+id/tvYearlyProfit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/placeholder_net"
                        android:textColor="#2196F3"
                        android:textStyle="bold"
                        android:textAlignment="center"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp">
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chartYearly"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:padding="8dp"/>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:text="@string/monthly_report_detail"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Spinner
                android:id="@+id/spinnerMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <!-- Monthly Summary Row (Reuse styles) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" app:cardCornerRadius="8dp" app:cardElevation="2dp">
                    <TextView android:id="@+id/tvMonthlyIncome" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="@string/placeholder_income" android:textColor="#4CAF50" android:textAlignment="center"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="4dp" app:cardCornerRadius="8dp" app:cardElevation="2dp">
                    <TextView android:id="@+id/tvMonthlyExpense" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="@string/placeholder_expense" android:textColor="#F44336" android:textAlignment="center"/>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" app:cardCornerRadius="8dp" app:cardElevation="2dp">
                    <TextView android:id="@+id/tvMonthlyProfit" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="@string/placeholder_net" android:textColor="#2196F3" android:textStyle="bold" android:textAlignment="center"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp">
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chartMonthly"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:padding="8dp"/>
            </androidx.cardview.widget.CardView>

            <!-- Kira Tahmini -->
             <TextView
                android:text="@string/next_year_rent_prediction"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_inflation_rate"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etInflationRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="@string/placeholder_percent" />
                    </com.google.android.material.textfield.TextInputLayout>
    
                    <TextView
                        android:id="@+id/tvPrediction"
                        android:text="@string/placeholder_prediction"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
    
                    <ToggleButton
                        android:id="@+id/toggleApplyInflation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textOn="@string/toggle_inflation_on"
                        android:textOff="@string/toggle_inflation_off"
                        android:backgroundTint="@color/design_default_color_primary"
                        android:textColor="@android:color/white"
                        android:padding="12dp"/>
                        
                    <TextView
                        android:text="@string/note_update_rent"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:textColor="#757575"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Aidat Tahmini -->
             <TextView
                android:text="@string/aidat_prediction_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_inflation_rate"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAidatInflationRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="0.0" />
                    </com.google.android.material.textfield.TextInputLayout>
    
                    <TextView
                        android:id="@+id/tvAidatPrediction"
                        android:text="@string/aidat_prediction_hint"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
    
                    <ToggleButton
                        android:id="@+id/toggleApplyAidatInflation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textOn="@string/btn_update_aidat"
                        android:textOff="@string/btn_apply_increase"
                        android:backgroundTint="@color/design_default_color_primary"
                        android:textColor="@android:color/white"
                        android:padding="12dp"/>
                        
                    <TextView
                        android:text="@string/note_aidat_update"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:textColor="#757575"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
